# Required on Hostinger. Keep the real token only in Hostinger Environment Variables.
CALENDLY_TOKEN=replace_with_your_private_calendly_token

# Optional. If omitted, the server automatically selects an active 20-minute
# Calendly event type when one exists, otherwise the first active event type.
# CALENDLY_EVENT_TYPE_URI=https://api.calendly.com/event_types/XXXXXXXXXXXX

# Hostinger normally provides PORT automatically.
# PORT=3000
