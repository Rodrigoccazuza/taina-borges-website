# Required on Hostinger. Keep the real key only in Hostinger Environment Variables.
CALCOM_API_KEY=replace_with_your_private_calcom_api_key

# Optional. If omitted, the server automatically selects a 20-minute event type
# when one exists, otherwise it uses the first event type returned by Cal.com.
# CALCOM_EVENT_TYPE_ID=123456

# Hostinger normally provides PORT automatically.
# PORT=3000
